# ---------------------------------------------------------------------------
# Local development. For a server deploy see .env.prod.example instead.
# ---------------------------------------------------------------------------

# Postgres — matches docker-compose.yml. For `npm run dev` on the host use localhost:5432.
DATABASE_URL="postgresql://tracker:tracker@localhost:5432/tracker?schema=public"

# Random string used to sign session cookies. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Telegram bot token from @BotFather. Leave empty to disable Telegram alerts.
TELEGRAM_BOT_TOKEN=""

# When the daily scrape runs (cron, server local time). Default 09:00 daily.
CHECK_CRON="0 9 * * *"

# Run a check immediately on worker startup (useful for testing).
CHECK_ON_BOOT="false"

# Timezone for the cron schedule.
TZ="Asia/Singapore"

# Who may create an account: open | invite | closed.
# Use "invite" with SIGNUP_CODE, or "closed" once your own account exists.
SIGNUP_MODE="open"
SIGNUP_CODE=""

# Ceiling on tracked items per account (each one is a scrape a day, forever).
# 0 disables the limit.
MAX_ITEMS_PER_USER="100"
