# ---------------------------------------------------------------------------
# Server deployment. Copy to .env.prod and fill in — every value below with a
# CHANGE_ME must be changed before this is reachable from the internet.
#
#   cp .env.prod.example .env.prod
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   # SESSION_SECRET
#   openssl rand -hex 24                                                     # POSTGRES_PASSWORD
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# ---------------------------------------------------------------------------

# The hostname Caddy will request a Let's Encrypt certificate for. Must already
# have a DNS A/AAAA record pointing at this server, and ports 80+443 open.
DOMAIN="tracker.example.com"

# Which image the app services run.
#   arcralius/price-tracker:0.2.0  -> pull the published image (no build needed)
#   price-tracker:local            -> build from source here, with `up -d --build`
# Pin a version rather than :latest so a redeploy can't silently change code.
APP_IMAGE="arcralius/price-tracker:0.2.0"

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL="you@example.com"

# Postgres. Not published to the host in the prod compose file — only the app
# containers can reach it — but use a real password anyway.
#
# Must be URL-safe: it is interpolated into DATABASE_URL, so / + @ : ? # and =
# break the connection string ("P1013 ... invalid port number"). Hex is safe;
# `openssl rand -base64` is not, since it emits / and +.
POSTGRES_PASSWORD="CHANGE_ME_openssl_rand_hex_24"

# Where the database files live.
#   pgdata                   -> Docker named volume (default, simplest)
#   /mnt/data/tracker/pgdata -> host directory bind mount
# Must be a LOCAL filesystem — Postgres on NFS/SMB risks silent corruption.
# On Unraid use the direct pool path (/mnt/cache/appdata/...), never /mnt/user/
# which is a FUSE overlay. See the Unraid section of the README.
# Changing this on an existing install does NOT move your data; see the README.
PGDATA_VOLUME="pgdata"

# Where Caddy keeps TLS certificates and its ACME account key. Persisting these
# avoids re-issuing certificates (and hitting Let's Encrypt rate limits) on
# every rebuild. Bare names are Docker volumes; paths are bind mounts.
CADDY_DATA_VOLUME="caddy_data"
CADDY_CONFIG_VOLUME="caddy_config"

# Signs session cookies. Changing it logs everyone out.
SESSION_SECRET="CHANGE_ME_64_hex_chars_from_crypto_randomBytes_32"

# Leave unset when running behind Caddy (HTTPS) — the cookie is Secure by
# default in production. Set to "false" ONLY if you reach the app over plain
# http on a LAN, e.g. http://tower:3000 with no reverse proxy: a Secure cookie
# is dropped by the browser over http, so login silently bounces back to the
# login page. Never set false on anything internet-facing.
# COOKIE_SECURE="false"

# Telegram bot token from @BotFather. Empty disables alerts.
TELEGRAM_BOT_TOKEN=""

# Daily scrape schedule and the timezone it's interpreted in.
CHECK_CRON="0 9 * * *"
CHECK_ON_BOOT="false"
TZ="Asia/Singapore"

# Lock registration down once your own account exists. Strongly recommended on
# a public server: "closed", or "invite" with a SIGNUP_CODE you share by hand.
SIGNUP_MODE="invite"
SIGNUP_CODE="CHANGE_ME_a_shared_secret"

MAX_ITEMS_PER_USER="100"

# OPTIONAL — read prices that are built by JavaScript.
#
# Uncomment BOTH lines to enable. Starts a Playwright/Chromium container
# (~2GB image) that is used only after every static strategy has failed, so
# ordinary sites are unaffected. A render takes ~5-20s.
#
# It runs on its own Docker network with no route to the database, since it
# loads arbitrary third-party pages.
# COMPOSE_PROFILES=browser
# BROWSER_WS_ENDPOINT=ws://browser:3000/
