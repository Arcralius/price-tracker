# Paste into: Compose → your stack → Edit Stack → .env File
# Only the two CHANGE_ME lines actually need editing.

# Generate with: openssl rand -hex 24
#
# Must be URL-safe — it is interpolated into DATABASE_URL, so / + @ : ? # and =
# will break the connection string. Don't use `openssl rand -base64`, which
# emits / and +; Prisma then fails with "P1013 ... invalid port number".
# Hex is safe by construction.
POSTGRES_PASSWORD=CHANGE_ME_a_long_random_password

# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_64_random_hex_characters

# Where the database lives.
#
# /mnt/cache/appdata/... is preferred over /mnt/user/appdata/... — the latter
# goes through shfs, Unraid's FUSE overlay, which Postgres would rather not sit
# on. If your appdata share is cache-only both paths are the same directory on
# disk, so use the /mnt/cache form and keep the standard layout.
#
# Confirm with:  ls -d /mnt/*/appdata
# If only the pool shows up, appdata is cache-only and you are fine.
PGDATA_VOLUME=/mnt/user/appdata/price-tracker/pgdata

# Published host port. Change if this one is taken on your server — check
# Docker → Container Port / LAN IP:PORT for what's already bound.
WEB_PORT=8383

# false = reachable over plain http on the LAN (http://tower:8383). A Secure
# cookie is discarded by the browser over http, and login would silently bounce
# back to the login page.
# Set true once SWAG / Nginx Proxy Manager / Caddy terminates HTTPS in front.
COOKIE_SECURE=false

APP_IMAGE=arcralius/price-tracker:0.2.0

# From @BotFather. Leave empty to run without Telegram alerts.
TELEGRAM_BOT_TOKEN=

# Daily scrape time, in the timezone below.
CHECK_CRON=0 9 * * *
TZ=Asia/Singapore

# Set to closed once your own account exists.
SIGNUP_MODE=open
SIGNUP_CODE=
MAX_ITEMS_PER_USER=100

# OPTIONAL — read prices that are built by JavaScript.
#
# Uncomment BOTH lines to enable. Starts a Playwright/Chromium container
# (~2GB image) that is used only after every static strategy has failed, so
# ordinary sites are unaffected. A render takes ~5-20s.
#
# It runs on its own Docker network with no route to the database, since it
# loads arbitrary third-party pages.
# COMPOSE_PROFILES=browser
# BROWSER_WS_ENDPOINT=ws://browser:3000/
